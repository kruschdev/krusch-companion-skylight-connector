# @krusch/companion-skylight-connector — Example Environment Configuration
# Copy this file to .env and fill in your Skylight Calendar 2 details.

# 1. Opt-In Cloud Synchronization Guard (0 = local/air-gapped only, 1 = authorize Skylight Cloud API)
ALLOW_SKYLIGHT=0

# 2. Skylight Calendar 2 Frame & Authentication
SKYLIGHT_BASE_URL=https://app.ourskylight.com
SKYLIGHT_FRAME_ID=your-frame-id
# Authenticate via Bearer/Session Token OR Email + Password:
SKYLIGHT_TOKEN=
SKYLIGHT_EMAIL=
SKYLIGHT_PASSWORD=

# 3. Optional Numeric List IDs & Magic Import ("Sidekick") Email
SKYLIGHT_MAGIC_IMPORT_EMAIL=your-frame@ourskylight.com
SKYLIGHT_GROCERY_LIST_ID=
SKYLIGHT_TODO_LIST_ID=

# 4. Optional Local SQLite Database & Calendar Bridge
SKYLIGHT_DB_PATH=./data/skylight.db
CALENDAR_BRIDGE_URL=http://127.0.0.1:5446
SKYLIGHT_PRIMARY_CALENDAR_PROFILE=family
SKYLIGHT_PRIMARY_CALENDAR_LABEL=Family Calendar
SKYLIGHT_SECONDARY_CALENDAR_PROFILE=grandparents
SKYLIGHT_SECONDARY_CALENDAR_LABEL=Grandparents & Extended Family

# 5. Optional HTTP MCP & Bot Webhook Server Security
SKYLIGHT_MCP_HOST=127.0.0.1
SKYLIGHT_MCP_PORT=5449
SKYLIGHT_MCP_API_KEY=
